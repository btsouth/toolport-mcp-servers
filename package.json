{
  "name": "toolport-mcp-servers",
  "version": "0.2.0",
  "description": "Curated, full-API MCP servers generated from official OpenAPI specs: Stripe (587 tools), Vercel (333), Clerk (224), Cloudflare (357: DNS, email routing, zones, WAF, SSL, R2, Access). One npx command, intent-friendly tool names. Unofficial.",
  "license": "MIT",
  "author": "tsouth89",
  "type": "commonjs",
  "bin": {
    "toolport-mcp-servers": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "vendors",
    "data",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/cli.js",
    "test": "node --test test/*.test.js",
    "prep:clerk": "bash scripts/prep-clerk.sh",
    "prep:vercel": "bash scripts/prep-vercel.sh",
    "prep:cloudflare": "bash scripts/prep-cloudflare.sh"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "stripe",
    "vercel",
    "clerk",
    "cloudflare",
    "openapi",
    "ai-agents",
    "claude",
    "cursor",
    "llm-tools"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/btsouth/toolport-mcp-servers.git"
  },
  "homepage": "https://toolport.app",
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
